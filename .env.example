# Supabase browser configuration.
# Publishable/anon keys are safe to expose in the browser when RLS is configured correctly.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-public-key
VITE_CLINIC_ID=your-clinic-uuid

# Optional custom Edge Function URLs. If omitted, the app derives them from VITE_SUPABASE_URL.
VITE_APPOINTMENT_FUNCTION_URL=
VITE_AVAILABILITY_FUNCTION_URL=

# Local demo login only. Keep disabled in production.
VITE_DEMO_ADMIN_ENABLED=false
VITE_DEMO_ADMIN_PASSWORD=change-me-for-local-demo

VITE_SITE_URL=https://your-production-domain.example

# Optional sitemap override. Comma-separated section keys from src/config/clinic.ts.
# If omitted, sitemap generation follows clinicConfig.siteSections.
VITE_ENABLED_SITE_SECTIONS=about,services,doctors,gallery,faq,contact,appointment,privacy,terms
